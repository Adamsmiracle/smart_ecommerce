<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.amalitech.smartecommerce.controller.OrderController"
      spacing="15" styleClass="content-panel" fillWidth="true">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <!-- Header with Filters -->
    <VBox spacing="10">
        <HBox alignment="CENTER_LEFT">
            <Label text="Order Management" styleClass="page-title" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
            <DatePicker fx:id="dpFromDate" promptText="From Date" prefWidth="130"/>
            <DatePicker fx:id="dpToDate" promptText="To Date" prefWidth="130"/>
            <ComboBox fx:id="cmbStatus" promptText="Order Status" prefWidth="130" minWidth="110"/>
            <Button text="Filter" onAction="#filterOrders" styleClass="primary-button"/>
            <Button text="Clear" onAction="#clearFilters" styleClass="secondary-button"/>
        </FlowPane>
    </VBox>

    <!-- Action Buttons -->
    <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
        <Button text="View Details" onAction="#showOrderDetails" styleClass="secondary-button"/>
        <Button text="Update Status" onAction="#updateOrderStatus" styleClass="action-button"/>
        <Button text="Delete" onAction="#deleteOrder" styleClass="danger-button"/>
        <Region HBox.hgrow="ALWAYS" minWidth="20"/>
        <Button text="Export Report" onAction="#exportReport" styleClass="secondary-button"/>
    </FlowPane>

    <!-- Orders Table -->
    <TableView fx:id="tblOrders" VBox.vgrow="ALWAYS" minHeight="200">
        <columns>
            <TableColumn fx:id="colOrderNum" text="Order #" minWidth="70" prefWidth="90"/>
            <TableColumn fx:id="colCustomer" text="Customer" minWidth="120" prefWidth="160"/>
            <TableColumn text="Order Date" minWidth="100" prefWidth="130">
                <cellValueFactory>
                    <PropertyValueFactory property="orderDate"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Total" minWidth="80" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="orderTotal"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colStatus" text="Status" minWidth="90" prefWidth="120"/>
            <TableColumn fx:id="colShipping" text="Shipping Method" minWidth="110" prefWidth="140"/>
        </columns>
        <placeholder>
            <Label text="No orders found."/>
        </placeholder>
    </TableView>

    <!-- Order Summary -->
    <FlowPane hgap="25" vgap="10" styleClass="summary-bar" alignment="CENTER_LEFT">
        <Label fx:id="lblTotalOrders" text="Total Orders: 0"/>
        <Label fx:id="lblTotalRevenue" text="Total Revenue: $0.00"/>
        <Label fx:id="lblPendingOrders" text="Pending: 0"/>
        <Label fx:id="lblCompletedOrders" text="Completed: 0"/>
    </FlowPane>
</VBox>

