<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.amalitech.smartecommerce.controller.LoginController"
            fitToWidth="true" fitToHeight="true"
            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED"
            styleClass="login-container">

    <StackPane styleClass="login-container" minWidth="320" minHeight="500">
        <VBox alignment="CENTER" spacing="20" maxWidth="450" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="40" left="40" right="40" top="40"/>
            </padding>

        <!-- Logo/Title -->
        <VBox alignment="CENTER" spacing="5" styleClass="login-header">
            <Label text="🛒" styleClass="login-logo">
                <font><Font size="48"/></font>
            </Label>
            <Label text="Smart E-Commerce" styleClass="login-title">
                <font><Font name="System Bold" size="28"/></font>
            </Label>
            <Label text="Sign in to your account" styleClass="login-subtitle"/>
        </VBox>

        <!-- Login Form -->
        <VBox fx:id="loginForm" spacing="15" styleClass="login-form">
            <VBox spacing="5">
                <Label text="Email Address" styleClass="form-label"/>
                <TextField fx:id="txtEmail" promptText="Enter your email" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="txtPassword" promptText="Enter your password" styleClass="form-input"/>
            </VBox>

            <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false"/>

            <Button text="Sign In as Customer" onAction="#handleLogin" styleClass="login-button" maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Don't have an account?"/>
                <Hyperlink text="Sign Up" onAction="#showRegisterForm" styleClass="link"/>
            </HBox>

            <!-- Admin Login Section -->
            <Separator/>
            <VBox alignment="CENTER" spacing="10" styleClass="admin-login-section">
                <Label text="Are you an administrator?" styleClass="admin-section-label"/>
                <Button text="🔐 Login as Admin" onAction="#showAdminLoginForm" styleClass="admin-login-btn" maxWidth="Infinity"/>
            </VBox>
        </VBox>

        <!-- Admin Login Form (hidden by default) -->
        <VBox fx:id="adminLoginForm" spacing="15" styleClass="login-form admin-form" visible="false" managed="false">
            <HBox alignment="CENTER" spacing="10">
                <Label text="🔐" styleClass="admin-icon"/>
                <Label text="Admin Login" styleClass="admin-form-title"/>
            </HBox>

            <VBox spacing="5">
                <Label text="Admin Email" styleClass="form-label"/>
                <TextField fx:id="txtAdminEmail" promptText="Enter admin email" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Admin Password" styleClass="form-label"/>
                <PasswordField fx:id="txtAdminPassword" promptText="Enter admin password" styleClass="form-input"/>
            </VBox>

            <Label fx:id="lblAdminError" styleClass="error-label" visible="false" managed="false"/>

            <Button text="Sign In as Admin" onAction="#handleAdminLogin" styleClass="admin-submit-btn" maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="5">
                <Hyperlink text="← Back to Customer Login" onAction="#showLoginForm" styleClass="link"/>
            </HBox>
        </VBox>

        <!-- Register Form (hidden by default) -->
        <VBox fx:id="registerForm" spacing="15" styleClass="login-form" visible="false" managed="false">
            <VBox spacing="5">
                <Label text="First Name" styleClass="form-label"/>
                <TextField fx:id="txtFirstName" promptText="Enter your first name" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Last Name" styleClass="form-label"/>
                <TextField fx:id="txtLastName" promptText="Enter your last name" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Email Address" styleClass="form-label"/>
                <TextField fx:id="txtRegEmail" promptText="Enter your email" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Phone Number" styleClass="form-label"/>
                <TextField fx:id="txtPhone" promptText="Enter your phone number" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Password" styleClass="form-label"/>
                <PasswordField fx:id="txtRegPassword" promptText="Create a password" styleClass="form-input"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Confirm Password" styleClass="form-label"/>
                <PasswordField fx:id="txtConfirmPassword" promptText="Confirm your password" styleClass="form-input"/>
            </VBox>

            <Label fx:id="lblRegError" styleClass="error-label" visible="false" managed="false"/>

            <Button text="Create Account" onAction="#handleRegister" styleClass="login-button" maxWidth="Infinity"/>

            <HBox alignment="CENTER" spacing="5">
                <Label text="Already have an account?"/>
                <Hyperlink text="Sign In" onAction="#showLoginForm" styleClass="link"/>
            </HBox>
        </VBox>
    </VBox>
    </StackPane>
</ScrollPane>

